# Copy to .env.local for local development. Every variable is optional.

# --- Gemini -------------------------------------------------------------------
# Local development: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# On Cloud Run, use Vertex AI with the service account instead of a key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# --- Storage ------------------------------------------------------------------
# memory (default) or firestore (shared across instances; uses GOOGLE_CLOUD_PROJECT)
DATA_BACKEND=memory
# Firestore database ID; use a named database to keep KisanSetu apart in a shared project
# FIRESTORE_DATABASE=(default)

# --- Tuning -------------------------------------------------------------------
# ENSEMBLE_YEARS=10
# SOIL_DEADLINE_MS=6000
# RATE_LIMIT_PER_MINUTE=60
# LOG_LEVEL=info
